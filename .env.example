# Hosted deployment configuration. Copy to .env, fill in, chmod 600.
# NEVER commit .env — .gitignore blocks it.
#
# Real environment variables always win over this file, so a container's injected
# secrets override anything here.

# ---- Google credential (required for hosted mode) -------------------------
# The service-account key, base64-encoded. Base64 because a private_key contains
# literal \n sequences that most .env parsers mangle:
#   base64 -i service-account-key.json | tr -d '\n'
SEO_MCP_SERVICE_ACCOUNT_JSON=

# Or, instead of the above, a path to the key file (local or a mounted secret):
# SEO_MCP_SERVICE_ACCOUNT_FILE=/secrets/service-account-key.json

# ---- Access control -------------------------------------------------------
# The endpoint path IS the access control. Generate a fresh one:
#   python -c "import secrets; print('/mcp/' + secrets.token_hex(16))"
SEO_MCP_ENDPOINT_PATH=/mcp/CHANGE-ME

# Public hostname(s) this server is reached on, comma-separated. REQUIRED behind a
# reverse proxy: the SDK rejects unknown Host headers with 421, so without this every
# proxied request fails. Leave blank for localhost-only or a tunnelled test.
SEO_MCP_ALLOWED_HOSTS=

# ---- Which property the team queries --------------------------------------
GSC_DEFAULT_SITE=sc-domain:stgconsulting.com
GA4_DEFAULT_PROPERTY=properties/256596325

# ---- Hosted-mode behaviour ------------------------------------------------
SEO_MCP_HOME=/tmp/seo-mcp
SEO_MCP_EXPORTS=0
SEO_MCP_LOG_LEVEL=INFO
